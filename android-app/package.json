{
  "name": "subble-android",
  "version": "1.3.1",
  "private": true,
  "description": "訂閱泡泡 Android 純離線版（Capacitor 包裝，資料只存在手機）",
  "scripts": {
    "prepare:web": "node scripts/prepare-web.mjs",
    "sync": "npm run prepare:web && cap sync android",
    "build:release": "npm run sync && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.4.0",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/share": "^7.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0"
  }
}
